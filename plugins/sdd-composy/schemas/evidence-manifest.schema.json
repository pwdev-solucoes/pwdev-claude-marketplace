{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-composy.local/schemas/evidence-manifest.schema.json",
  "title": "SDD Composy criterion-linked evidence manifest v1",
  "type": "object",
  "required": ["schema_version", "prd_slug", "task_id", "generated_at", "entries"],
  "properties": {
    "schema_version": {"const": "1"},
    "prd_slug": {"$ref": "#/definitions/prd_slug"},
    "task_id": {"$ref": "#/definitions/task_id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}}
  },
  "additionalProperties": true,
  "definitions": {
    "prd_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "requirement_id": {"type": "string", "pattern": "^RF-[0-9]{3,}$"},
    "story_id": {"type": "string", "pattern": "^US-[0-9]{3,}$"},
    "scenario_id": {"type": "string", "pattern": "^SC-[0-9]{3,}$"},
    "criterion_id": {"type": "string", "pattern": "^CA-[0-9]{3,}$"},
    "test_id": {"type": "string", "pattern": "^TEST-[0-9]{3,}$"},
    "result": {"enum": ["passed", "failed", "not_applicable"]},
    "evidence_type": {"enum": ["test_output", "screenshot", "log", "report"]},
    "evidence_path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))tasks/prd-[a-z0-9]+(?:-[a-z0-9]+)*/evidences/[^/].+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "required": ["requirement_id", "story_id", "scenario_id", "criterion_id", "test_id", "result", "evidence_type", "path", "sha256"],
      "properties": {
        "requirement_id": {"$ref": "#/definitions/requirement_id"},
        "story_id": {"$ref": "#/definitions/story_id"},
        "scenario_id": {"$ref": "#/definitions/scenario_id"},
        "criterion_id": {"$ref": "#/definitions/criterion_id"},
        "test_id": {"$ref": "#/definitions/test_id"},
        "result": {"$ref": "#/definitions/result"},
        "evidence_type": {"$ref": "#/definitions/evidence_type"},
        "path": {"$ref": "#/definitions/evidence_path"},
        "sha256": {"$ref": "#/definitions/sha256"}
      },
      "additionalProperties": true
    }
  }
}
