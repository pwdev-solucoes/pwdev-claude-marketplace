{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-composy.local/schemas/fleet-member.schema.json",
  "title": "SDD Composy fleet member v1",
  "type": "object",
  "required": ["schema_version", "id", "task_id", "status", "runtime", "ui", "branch", "worktree_path", "started_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"$ref": "#/definitions/member_id"},
    "task_id": {"$ref": "#/definitions/task_id"},
    "status": {"$ref": "#/definitions/member_status"},
    "runtime": {"$ref": "#/definitions/runtime"},
    "ui": {"$ref": "#/definitions/ui"},
    "branch": {"type": "string", "minLength": 1},
    "worktree_path": {"$ref": "#/definitions/relative_path"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "result_path": {"$ref": "#/definitions/relative_path"},
    "message": {"type": "string", "minLength": 1}
  },
  "if": {"properties": {"status": {"enum": ["completed", "failed", "blocked", "cancelled"]}}, "required": ["status"]},
  "then": {"required": ["finished_at", "result_path"]},
  "additionalProperties": true,
  "definitions": {
    "member_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "member_status": {"enum": ["pending", "running", "completed", "failed", "blocked", "cancelled"]},
    "runtime": {"enum": ["claude-code", "codex"]},
    "ui": {"enum": ["cmux", "tmux", "headless"]},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
