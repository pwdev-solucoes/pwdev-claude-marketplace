{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-composy.local/schemas/tasks.schema.json",
  "title": "SDD Composy task state v1",
  "type": "object",
  "required": ["schema_version", "prd_slug", "updated_at", "tasks"],
  "properties": {
    "schema_version": {"const": "1"},
    "prd_slug": {"$ref": "#/definitions/prd_slug"},
    "updated_at": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "items": {"$ref": "#/definitions/task"}}
  },
  "additionalProperties": true,
  "definitions": {
    "prd_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "criterion_id": {"type": "string", "pattern": "^CA-[0-9]{3,}$"},
    "task_state": {"enum": ["pending", "ready", "running", "qa_required", "evidence_required", "review_required", "verify_required", "complete", "blocked", "rejected", "skipped"]},
    "task": {
      "type": "object",
      "required": ["id", "title", "state", "dependencies", "acceptance_criteria", "verification_commands", "allowed_paths", "evidence_required"],
      "properties": {
        "id": {"$ref": "#/definitions/task_id"},
        "title": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/definitions/task_state"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/task_id"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/criterion_id"}},
        "verification_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "evidence_required": {"type": "boolean"},
        "claimed_by": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "justification": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
