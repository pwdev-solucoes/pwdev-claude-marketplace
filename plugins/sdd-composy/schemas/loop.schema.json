{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-composy.local/schemas/loop.schema.json",
  "title": "SDD Composy autonomous loop v1",
  "type": "object",
  "required": ["schema_version", "id", "task_id", "status", "iteration", "max_iterations", "started_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"$ref": "#/definitions/loop_id"},
    "task_id": {"$ref": "#/definitions/task_id"},
    "status": {"$ref": "#/definitions/loop_status"},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "default": 3},
    "stop_reason": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "if": {"properties": {"status": {"enum": ["completed", "iteration_cap", "missing_progress", "scope_expansion", "architectural_ambiguity", "destructive_action", "external_authorization", "environment_failure", "cancelled"]}}, "required": ["status"]},
  "then": {"required": ["stop_reason", "finished_at"]},
  "additionalProperties": true,
  "definitions": {
    "loop_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "loop_status": {"enum": ["pending", "running", "completed", "iteration_cap", "missing_progress", "scope_expansion", "architectural_ambiguity", "destructive_action", "external_authorization", "environment_failure", "cancelled"]}
  }
}
