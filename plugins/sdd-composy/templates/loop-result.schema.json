{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-composy.local/schemas/loop-result.schema.json",
  "title": "SDD Composy runtime loop result v1",
  "type": "object",
  "required": ["stage", "status", "message", "verdict", "evidence"],
  "additionalProperties": false,
  "properties": {
    "stage": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "blocked", "needs_human"]},
    "message": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["passed", "approved", "rejected", "blocked", "needs_human"]},
    "evidence": {"type": "object"}
  }
}
