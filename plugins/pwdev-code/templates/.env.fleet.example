# Example of the variables scripts/fleet-up.sh generates per worktree as
# .env.fleet (not versioned — regenerated on every /pwdev-code:fleet launch,
# with real ports substituted for the placeholders below).
FLEET_PROJECT_NAME=fleet-<slug>
FLEET_APP_PORT=3000
FLEET_APP_INTERNAL_PORT=3000
FLEET_DB_PORT=5432
FLEET_DB_NAME=app
FLEET_DB_USER=app
FLEET_DB_PASSWORD=app
FLEET_APP_DOCKERFILE=Dockerfile
