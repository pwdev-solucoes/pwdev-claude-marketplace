#!/usr/bin/env bash
# SessionStart hook: inject the bootstrap skill so the agent knows to use Power skills before
# it does anything else.
#
# Extensionless on purpose: Claude Code's Windows auto-detection prefixes `bash` to any command
# containing `.sh`, which breaks the polyglot launcher.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
PLUGIN_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
SKILL_FILE=$PLUGIN_ROOT/skills/power/SKILL.md

[[ -f $SKILL_FILE ]] || exit 0

SKILL_CONTENT=$(cat "$SKILL_FILE")

# One C-level pass per substitution, rather than a character loop: this runs on every session
# start, clear and compact.
escape_for_json() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

PAYLOAD="<EXTREMELY_IMPORTANT>
This repository uses PWDEV Power.

**Below is the full content of the 'pwdev-power:power' skill — how to find and apply Power skills. For all other skills, use the Skill tool.**

${SKILL_CONTENT}
</EXTREMELY_IMPORTANT>"

ESCAPED=$(escape_for_json "$PAYLOAD")

# Exactly one field, chosen by platform. Claude Code reads both additional_context and
# hookSpecificOutput without de-duplicating, so emitting both would inject the bootstrap twice.
#
# printf, not a heredoc: bash 5.3+ hangs on the heredoc form here.
if [[ -n ${CURSOR_PLUGIN_ROOT:-} ]]; then
  printf '{"additional_context":"%s"}\n' "$ESCAPED"
elif [[ -n ${CLAUDE_PLUGIN_ROOT:-} && -z ${COPILOT_CLI:-} ]]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$ESCAPED"
else
  printf '{"additionalContext":"%s"}\n' "$ESCAPED"
fi
