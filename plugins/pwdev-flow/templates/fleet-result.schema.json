{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "status", "message", "verdict"],
  "properties": {
    "stage": {
      "enum": ["plan", "execute", "review", "verify", "execute-fix", "review-fix"]
    },
    "status": {
      "enum": ["OK", "FAILED", "NEEDS_HUMAN"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": ["NONE", "APPROVED", "CAVEATS", "REJECTED"]
    }
  }
}
