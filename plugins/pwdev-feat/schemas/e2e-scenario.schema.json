{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pwdev-solucoes/pwdev-claude-marketplace/plugins/pwdev-feat/schemas/e2e-scenario.schema.json",
  "title": "pwdev-feat E2E scenario",
  "description": "Declarative end-to-end scenario, traceable to plan acceptance criteria, exportable to Playwright Test. Secrets are never literal: use ${env:NAME}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "feature_slug", "ac_refs", "priority", "preconditions", "variants"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^E2E-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "feature_slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "ac_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AC-[0-9]{3,}$"}
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
    "preconditions": {"$ref": "#/$defs/preconditions"},
    "data": {"type": "object"},
    "setup_steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variant"},
      "contains": {"type": "object", "properties": {"name": {"const": "happy_path"}}, "required": ["name"]}
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation_error": {"type": "string", "minLength": 1},
        "forbidden": {"type": "string", "minLength": 1},
        "empty_state": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "env_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url_env"],
      "properties": {
        "base_url_env": {"$ref": "#/$defs/env_name"},
        "start_path": {"type": "string", "pattern": "^/"},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 200}, "height": {"type": "integer", "minimum": 200}}
        },
        "users": {"type": "array", "items": {"$ref": "#/$defs/user"}},
        "state": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "credentials_env"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "credentials_env": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/env_name"}
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "value"],
      "properties": {
        "by": {"enum": ["role", "label", "placeholder", "text", "testid", "css"]},
        "value": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "exact": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"enum": ["goto", "click", "fill", "select", "check", "uncheck", "press", "upload", "hover", "wait"]},
        "target": {"$ref": "#/$defs/locator"},
        "value": {"type": "string"},
        "key": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expect"],
      "properties": {
        "expect": {"enum": ["visible", "hidden", "text", "url", "count", "value", "enabled", "disabled", "checked"]},
        "target": {"$ref": "#/$defs/locator"},
        "value": {"type": ["string", "integer"]},
        "note": {"type": "string"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "steps", "assertions"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "as_user": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
      }
    }
  }
}
