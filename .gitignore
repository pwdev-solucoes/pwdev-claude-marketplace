# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment & local config
.env
.env.local
.env.*.local
*.local.json

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# pwdev-uiex state (option 1: do not version)
# .planning/ui/

# pwdev-uiex state (option 2: version as living documentation)
# — already tracked, no ignore needed
.ai
.superpowers
.claude
# .agents is versioned: AGENTS.md references .agents/rules/* and the marketplace catalogue lives there
.docs
.worktrees/

# .planning is agent state and stays out, with one carve-out: pwdev-power keeps its approved
# contracts under .planning/power/, and its fleet runner decides whether a stage did any work by
# asking git whether the feature directory is dirty — which git never says of an ignored path.
# See plugins/pwdev-power/references/artifacts.md.
.planning/

# Python bytecode
__pycache__/
*.pyc

# Review diff packages are disposable evidence, regenerated on demand
review-*.diff
.planning/power/features/*/review-packages/

# Session pointer (active feature / next action) — per-checkout, never merged
.planning/power/state.md
