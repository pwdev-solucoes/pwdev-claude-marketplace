# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment & local config
.env
.env.local
.env.*.local
*.local.json

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# pwdev-uiex state (option 1: do not version)
# .planning/ui/

# pwdev-uiex state (option 2: version as living documentation)
# — already tracked, no ignore needed
.ai
.superpowers
.claude
# .agents is versioned: it holds the Codex marketplace catalogue and the skill links
.docs
.worktrees/

# .planning is agent state and stays out entirely. Note the consequence for pwdev-power: its
# fleet runner detects stage work through git dirtiness of the feature directory, and fleet-up
# refuses to launch when the contracts are ignored — so fleets are not run on this repository.
# See plugins/pwdev-power/references/artifacts.md.
.planning/

# Python bytecode
__pycache__/
*.pyc

# Review diff packages are disposable evidence, regenerated on demand
review-*.diff
.planning/power/features/*/review-packages/

# Session pointer (active feature / next action) — per-checkout, never merged
.planning/power/state.md

# Local virtualenv (PDF verification environment for pwdev-qa tests)
.venv/
