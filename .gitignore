# pwdev-uiex state (option 1: do not version)
# .planning/ui/

# pwdev-uiex state (option 2: version as living documentation)
# — already tracked, no ignore needed
.ai
.superpowers
.claude
.agents
.docs

# .planning is agent state and stays out, with one carve-out: pwdev-power keeps its approved
# contracts under .planning/power/, and its fleet runner decides whether a stage did any work by
# asking git whether the feature directory is dirty — which git never says of an ignored path.
# See plugins/pwdev-power/references/artifacts.md.
.planning/*
!.planning/power/
.planning/power/audit/
.planning/power/fleet/
.planning/power/fleet-status.json
.planning/power/fleet-logs/
.planning/power/fleet-results/
.planning/power/features/*/review-*.diff
